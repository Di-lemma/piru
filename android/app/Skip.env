// Piru for Android. Shared between the generated Darwin project and Android/settings.gradle.kts;
// Skip writes these into AndroidManifest.xml.

// PRODUCT_NAME must match the app's Swift module name.
PRODUCT_NAME = Piru

PRODUCT_BUNDLE_IDENTIFIER = glass.kagerou.piru

// stage.py replaces these two with the iOS project's MARKETING_VERSION and CURRENT_PROJECT_VERSION.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 0

// The package of the generated Android entry point.
ANDROID_PACKAGE_NAME = glass.kagerou.piru
