<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The journal never goes to Google's cloud backup, and key material
     never leaves the device, so neither backup nor device-to-device transfer carries any
     app domain. Moving to a new phone goes through Settings > Data & Backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
