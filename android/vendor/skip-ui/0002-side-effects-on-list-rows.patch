+
+    // A List draws its rows through RenderListItem, never Render, so without this a `.task`
+    // or `.onAppear` whose first view became a row (a Group's in a List) never ran.
+    @Composable override func RenderListItem(content: Renderable, context: ComposeContext, modifiers: kotlin.collections.List<ModifierProtocol>) {
+        action?(context)
+        content.RenderListItem(context: context, modifiers: modifiers)
+    }
