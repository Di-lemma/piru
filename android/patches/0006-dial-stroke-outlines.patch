     let sweepDeg: Double
 
     func path(in _: CGRect) -> Path {
+        #if os(Android)
+            return .androidStrokedArc(
+                center: center, radius: radius, startDegrees: startDeg, endDegrees: startDeg + sweepDeg, width: thickness,
+            )
+        #else
         var path = Path()
         path.addArc(
             center: center, radius: radius,
@@ -592,6 +617,7 @@ private nonisolated struct ArcRing: Shape {
             clockwise: false,
         )
         return path.strokedPath(StrokeStyle(lineWidth: thickness, lineCap: .round))
+        #endif
     }
 }
 
