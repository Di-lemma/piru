SkinBackdrop on Android: the skin's plain background, within the safe area. The decoration scene is a per-frame Canvas Compose cannot draw, and a backdrop past the top edge covers Skip's search field

diff --git a/Piru/Views/Components/SkinBackdrop.swift b/Piru/Views/Components/SkinBackdrop.swift
index 8375ba6d..d064468d 100644
--- a/Piru/Views/Components/SkinBackdrop.swift
+++ b/Piru/Views/Components/SkinBackdrop.swift
@@ -7,7 +7,13 @@ extension View {
     /// *fills* with `Theme.background` (dot rings, fades) keeps the plain color.
     /// Screen roots only: a component that paints this multiplies the layer.
     func skinBackdrop() -> some View {
-        background { SkinBackdrop().ignoresSafeArea() }
+        #if os(Android)
+            // Within the safe area: Skip lays a `.searchable` field out above the content,
+            // and a backdrop reaching past the top would paint over it.
+            background { SkinBackdrop() }
+        #else
+            background { SkinBackdrop().ignoresSafeArea() }
+        #endif
     }
 }
 
@@ -53,6 +59,7 @@ struct SkinBackdrop: View {
         let skin = skin ?? skins.current
         ZStack {
             skin.background
+            #if !os(Android)
             if let decor = skin.decorations, self.skin != nil || skins.decorationsEnabled {
                 if case .stickers = decor.scene {
                     stickerGlow(skin)
@@ -112,6 +119,7 @@ struct SkinBackdrop: View {
                     StainedGlass(tint: skin.background, lead: skin.palette.stroke)
                 }
             }
+            #endif
         }
         .onChange(of: isPresented, initial: true) { _, presented in
             if presented { wasPresented = true }
