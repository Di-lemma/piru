+            // back as the same kind of color.
+            if let c = base.androidComponents {
+                let oklch = Oklch(displayP3: P3Color(red: c.red, green: c.green, blue: c.blue))
+                var colors: [TimelineCurvePhase: Color] = [:]
+                for phase in TimelineCurvePhase.allCases {
+                    let p3 = phase.shifted(oklch).displayP3
+                    colors[phase] = Color(.displayP3, red: p3.red, green: p3.green, blue: p3.blue)
+                }
+                self.colors = colors
+            } else {
+                colors = Dictionary(uniqueKeysWithValues: TimelineCurvePhase.allCases.map { ($0, base) })
+            }
+        #else
+            let resolved = base.resolve(in: environment)
+            let oklch = Oklch(
+                linearRed: Double(resolved.linearRed),
+                green: Double(resolved.linearGreen),
+                blue: Double(resolved.linearBlue),
+            )
+            var colors: [TimelineCurvePhase: Color] = [:]
+            for phase in TimelineCurvePhase.allCases {
+                let rgb = phase.shifted(oklch).linearRGB
+                colors[phase] = Color(.sRGBLinear, red: rgb.red, green: rgb.green, blue: rgb.blue)
+            }
+            self.colors = colors
+        #endif
     }
 
