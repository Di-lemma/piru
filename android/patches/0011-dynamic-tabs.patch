+
+    #if os(Android)
+        /// SkipFuseUI's tab builder composes neither ForEach nor a bare `if` (its buildIf
+        /// yields a non-TabContent Optional), so the bar is chosen by count: at most four
+        /// tabs plus Search.
+        @TabContentBuilder<TabID>
+        private func androidTabs(_ tabs: [TabID]) -> some TabContent<TabID> {
+            if tabs.count >= 5 {
+                androidTab(tabs[0]); androidTab(tabs[1]); androidTab(tabs[2]); androidTab(tabs[3]); androidTab(tabs[4])
+            } else if tabs.count == 4 {
+                androidTab(tabs[0]); androidTab(tabs[1]); androidTab(tabs[2]); androidTab(tabs[3])
+            } else if tabs.count == 3 {
+                androidTab(tabs[0]); androidTab(tabs[1]); androidTab(tabs[2])
+            } else if tabs.count == 2 {
+                androidTab(tabs[0]); androidTab(tabs[1])
+            } else {
+                androidTab(tabs.first ?? .journal)
+            }
+        }
+
+        @TabContentBuilder<TabID>
+        private func androidTab(_ tab: TabID) -> some TabContent<TabID> {
+            Tab(value: tab) {
+                NavigationStack(path: navigator.pathBinding(for: tab)) {
+                    if tab == .search {
+                        SearchView(scope: $searchScope, searchText: $searchText)
+                            .withAppDestinations()
+                    } else {
+                        TabRootView(tab: tab, searchText: $searchText, librarySearchText: $librarySearchText)
+                            .withAppDestinations()
+                    }
+                }
+            } label: {
+                Label {
+                    Text(tab.title)
+                } icon: {
+                    Image(systemName: tab.systemImage)
+                }
+            }
+        }
+    #endif
 }
 
